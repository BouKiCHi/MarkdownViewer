<Window x:Class="MarkdownViewer.GoToLineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="指定行へ移動"
        Width="360"
        SizeToContent="Height"
        MinWidth="360"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Text="指定行へ移動" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="12"
                       Foreground="#555"
                       Text="{Binding LineCountDescription}" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,16,0,0">
            <TextBlock FontSize="13"
                       Foreground="#333"
                       Text="行番号" />
            <TextBox x:Name="LineNumberTextBox"
                     Height="32"
                     Margin="0,6,0,0"
                     VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="88"
                    Height="32"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Content="キャンセル" />
            <Button Width="88"
                    Height="32"
                    Click="GoButton_Click"
                    IsDefault="True"
                    Content="移動" />
        </StackPanel>
    </Grid>
</Window>

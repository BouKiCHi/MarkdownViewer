<Window x:Class="MarkdownViewer.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="バージョン情報"
        Width="420"
        Height="300"
        MinWidth="420"
        MinHeight="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F7F8FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="18"
                Background="White"
                BorderBrush="#D9DDE3"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <TextBlock Text="Markdown Viewer"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#1F2937" />
                <TextBlock x:Name="VersionTextBlock"
                           Margin="0,10,0,0"
                           FontSize="13"
                           Foreground="#4B5563" />
                <TextBlock Margin="0,18,0,0"
                           FontSize="12"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"
                           Text="Markdown ファイルをプレビュー表示するデスクトップアプリケーションです。" />
                <TextBlock Margin="0,16,0,0"
                           FontSize="12"
                           Foreground="#374151">
                    <Hyperlink Click="ReleasePageHyperlink_Click">リリースページを開く</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <Button Grid.Row="1"
                Width="88"
                Height="32"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Content="閉じる" />
    </Grid>
</Window>
